ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://docflow:docflow_password@localhost:5432/docflow
TEST_DATABASE_URL=postgresql+psycopg://docflow:docflow_password@localhost:5433/docflow_test
DB_USER=docflow
DB_PASSWORD=docflow_password
DB_NAME=docflow
JWT_SECRET=supersecretjwtkeythatisatleast32characterslongforsecurity
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_BYTES=10485760

# Redis & Celery
HOST_REDIS_PORT=6380
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

# LLM Extraction Settings
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=8192

# CORS Settings (comma-separated origins, never wildcard with credentials)
CORS_ORIGINS=http://localhost:5173
